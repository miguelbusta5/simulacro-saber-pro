# Cadena de conexión de Postgres. Sirve cualquier proveedor: la app no depende
# de ninguno en particular.
#
# NEON (neon.tech): Dashboard -> Connect, o bien `npx neon@latest env pull`,
# que escribe las dos variables de abajo automáticamente.
#
# SUPABASE (supabase.com): Project Settings -> Database -> Connection string ->
# URI. Usa la del "Session pooler", NO la "Direct connection": esa última solo
# responde por IPv6 y falla desde Render.
#
# Reemplaza el marcador por la contraseña real de la base de datos.
#
# Copia este archivo como .env y pega tu URI aquí. El .env está en .gitignore:
# nunca se sube al repositorio.

# Conexión agrupada (en Neon, el host lleva el sufijo "-pooler"). Es la que usa
# la aplicación: muchas conexiones cortas, una por petición.
DATABASE_URL=postgresql://usuario:TU_PASSWORD@host.proveedor.com:5432/postgres

# Opcional, solo para `npm run smoke`. Conexión directa, sin agrupar. La prueba
# crea un esquema temporal y lo fija en la conexión, y eso es una operación de
# sesión que las conexiones agrupadas no admiten. Si no la defines, la prueba
# usa DATABASE_URL, lo que funciona en un Postgres normal pero puede fallar
# contra un endpoint agrupado.
# DATABASE_URL_UNPOOLED=postgresql://usuario:TU_PASSWORD@host.proveedor.com:5432/postgres

# Opcional. Puerto local del servidor (por defecto 3000).
# PORT=3000

# Opcional. Desactiva la validación del certificado TLS del servidor. Solo para
# un Postgres propio con certificado autofirmado: con los proveedores
# administrados la validación funciona y protege contra suplantación.
# PG_SSL_SIN_VERIFICAR=1
